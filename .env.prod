# Porta da Aplicação Java
JAVA_HOST_PORT=8082
JAVA_CONTAINER_PORT=8082

# Base de Dados SQL Server (container na rede infra_net)
SPRING_DATASOURCE_URL=jdbc:sqlserver://sqlserver2022:1433;databaseName=Condominio_aspnet;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=Senh@Forte2026!

# RabbitMQ (container na rede infra_net)
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=admin_geral
SPRING_RABBITMQ_PASSWORD=Senh@Forte2026!

# Configurações do Spring
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
LOGGING_LEVEL_ROOT=INFO
MANAGEMENT_ENDPOINT_HEALTH_SHOWDETAILS=always

# Configurações JWT
APP_JWT_KEY=SuaChaveSecretaMuitoLongaESeguraAqui2026!
APP_JWT_ISSUER=CondominioSaaS
APP_JWT_AUDIENCE=CondominioSaaS
APP_JWT_EXPIREMINUTES=60

# Rede Docker Externa
DOCKER_NETWORK=infra_net

# Profile ativo
SPRING_PROFILES_ACTIVE=prod